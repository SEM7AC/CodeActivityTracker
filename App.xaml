<Application x:Class="CodeActivityTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CodeActivityTracker"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style x:Key="FlatBarSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="{TemplateBinding Height}">
                            <Border Background="#2A2A2A" CornerRadius="2"/>
                            <Border Background="{TemplateBinding Foreground}"
                                CornerRadius="2"
                                Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value}"
                                HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#2A2A2A"/>
        </Style>
    </Application.Resources>

</Application>
