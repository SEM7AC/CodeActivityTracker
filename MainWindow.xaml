<Window x:Class="CodeActivityTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Code Activity Tracker"
        Width="600" Height="260"
        Background="#1E1E1E"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True">

    <Border Background="#1E1E1E" CornerRadius="6">

        <Grid>

            <!-- HEADER BAR (for dragging + buttons) -->
            <Grid Background="#262626" Height="32" VerticalAlignment="Top"
                  MouseDown="Header_MouseDown">

                <!-- Title -->
                <TextBlock Text="Code Activity Tracker"
                           Foreground="White"
                           FontSize="14"
                           Margin="12 0 0 0"
                           VerticalAlignment="Center"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0 0 8 0">

                    <!-- Minimize -->
                    <Button Width="24" Height="24"
                            Background="#333"
                            Foreground="White"
                            Content="—"
                            Click="Minimize_Click"
                            BorderThickness="0"
                            FontSize="14"/>

                    <!-- Close -->
                    <Button Width="24" Height="24"
                            Background="#333"
                            Foreground="White"
                            Content="X"
                            Click="Close_Click"
                            BorderThickness="0"
                            FontSize="14"
                            Margin="4 0 0 0"/>
                </StackPanel>
            </Grid>

            <!-- MAIN CONTENT -->
            <StackPanel Margin="16 48 16 16" Orientation="Vertical">

                <!-- Typing -->
                <StackPanel Margin="0 10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Typing"
                                   Foreground="White"
                                   FontSize="14"
                                   Grid.Column="0"/>

                        <TextBlock x:Name="TypeTime"
                                   Text="00:12:33"
                                   Foreground="White"
                                   FontSize="14"
                                   Grid.Column="1"/>
                    </Grid>

                    <Grid Height="4" Margin="0 4 0 0">
                        <Rectangle Fill="#2A2A2A"
                                   Height="4"
                                   RadiusX="2" RadiusY="2"/>
                        <Rectangle x:Name="TypingFill" 
                                   Fill="LimeGreen"
                                   Height="4"
                                   Width="120"
                                   HorizontalAlignment="Left"
                                   RadiusX="2" RadiusY="2"/>
                    </Grid>
                </StackPanel>

                <!-- IDE Work -->
                <StackPanel Margin="0 10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="IDE Work"
                                   Foreground="White"
                                   FontSize="14"
                                   Grid.Column="0"/>

                        <TextBlock x:Name="IDETime"
                                   Text="00:05:10"
                                   Foreground="White"
                                   FontSize="14"
                                   Grid.Column="1"/>
                    </Grid>

                    <Grid Height="4" Margin="0 4 0 0">
                        <Rectangle Fill="#2A2A2A"
                                   Height="4"
                                   RadiusX="2" RadiusY="2"/>
                        <Rectangle x:Name="IDEFill" 
                                   Fill="DeepSkyBlue"
                                   Height="4"
                                   Width="80"
                                   HorizontalAlignment="Left"
                                   RadiusX="2" RadiusY="2"/>
                    </Grid>
                </StackPanel>

                <!-- Debugging -->
                <StackPanel Margin="0 10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Debugging"
                                   Foreground="White"
                                   FontSize="14"
                                   Grid.Column="0"/>

                        <TextBlock x:Name="DebugTime"
                                   Text="00:01:44"
                                   Foreground="White"
                                   FontSize="14"
                                   Grid.Column="1"/>
                    </Grid>

                    <Grid Height="4" Margin="0 4 0 0">
                        <Rectangle Fill="#2A2A2A"
                                   Height="4"
                                   RadiusX="2" RadiusY="2"/>
                        <Rectangle x:Name="DebugFill" 
                                   Fill="Gold"
                                   Height="4"
                                   Width="40"
                                   HorizontalAlignment="Left"
                                   RadiusX="2" RadiusY="2"/>
                    </Grid>
                </StackPanel>

                <!-- Idle -->
                <StackPanel Margin="0 10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Idle (24hr)"
                                   Foreground="White"
                                   FontSize="14"
                                   Grid.Column="0"/>

                        <TextBlock x:Name="IdleTime"
                                   Text="04:55:12"
                                   Foreground="White"
                                   FontSize="14"
                                   Grid.Column="1"/>
                    </Grid>

                    <Grid Height="4" Margin="0 4 0 0">
                        <Rectangle Fill="#2A2A2A"
                                   Height="4"
                                   RadiusX="2" RadiusY="2"/>
                        <Rectangle x:Name="IdleFill" 
                                   Fill="#666"
                                   Height="4"
                                   Width="300"
                                   HorizontalAlignment="Left"
                                   RadiusX="2" RadiusY="2"/>
                    </Grid>
                </StackPanel>

            </StackPanel>

        </Grid>
    </Border>
</Window>
