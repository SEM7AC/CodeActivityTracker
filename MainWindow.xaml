<Window x:Class="CodeActivityTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Code Activity Tracker"
        Width="600" Height="260"
        Background="#1E1E1E"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True">

    <Border Background="#1E1E1E" CornerRadius="6">

        <Grid>

            <!-- HEADER BAR -->
            <Grid Background="#262626" Height="32" VerticalAlignment="Top"
                  MouseDown="Header_MouseDown">

                <TextBlock Text="Code Activity Tracker"
                           Foreground="White"
                           FontSize="14"
                           Margin="12 0 0 0"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0 0 8 0">

                    <Button Width="24" Height="24"
                            Background="#333"
                            Foreground="White"
                            Content="—"
                            Click="Minimize_Click"
                            BorderThickness="0"
                            FontSize="14"/>

                    <Button Width="24" Height="24"
                            Background="#333"
                            Foreground="White"
                            Content="X"
                            Click="Close_Click"
                            BorderThickness="0"
                            FontSize="14"
                            Margin="4 0 0 0"/>
                </StackPanel>
            </Grid>

            <!-- MAIN CONTENT -->
            <StackPanel Margin="16 48 16 16" Orientation="Vertical">

                <!-- Typing -->
                <StackPanel Margin="0 10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Typing"
                                   Foreground="White"
                                   FontSize="14"
                                   Grid.Column="0"/>

                        <TextBlock x:Name="TypingFlipsLabel"
                                   Text="x0"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="8 0 0 0"
                                   Grid.Column="1"/>

                        <TextBlock Text=""
                                   Grid.Column="2"/>

                        <TextBlock x:Name="TypeTime"
                                   Text="00:12:33"
                                   Foreground="White"
                                   FontSize="14"
                                   Grid.Column="3"/>
                    </Grid>

                    <Grid Height="4" Margin="0 4 0 0">
                        <Slider x:Name="TypingBar"
                                Style="{StaticResource FlatBarSlider}"
                                Foreground="LimeGreen"
                                Height="4"
                                Maximum="600"
                                Value="0"/>
                    </Grid>
                </StackPanel>

                <!-- IDE Work -->
                <StackPanel Margin="0 10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="IDE Work"
                                   Foreground="White"
                                   FontSize="14"
                                   Grid.Column="0"/>

                        <TextBlock x:Name="IDEFlipsLabel"
                                   Text="x0"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="8 0 0 0"
                                   Grid.Column="1"/>

                        <TextBlock Text=""
                                   Grid.Column="2"/>

                        <TextBlock x:Name="IDETime"
                                   Text="00:05:10"
                                   Foreground="White"
                                   FontSize="14"
                                   Grid.Column="3"/>
                    </Grid>

                    <Grid Height="4" Margin="0 4 0 0">
                        <Slider x:Name="IDEBar"
                                Style="{StaticResource FlatBarSlider}"
                                Foreground="DeepSkyBlue"
                                Height="4"
                                Maximum="600"
                                Value="0"/>
                    </Grid>
                </StackPanel>

                <!-- Debugging -->
                <StackPanel Margin="0 10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Debugging"
                                   Foreground="White"
                                   FontSize="14"
                                   Grid.Column="0"/>

                        <TextBlock x:Name="DebugFlipsLabel"
                                   Text="x0"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="8 0 0 0"
                                   Grid.Column="1"/>

                        <TextBlock Text=""
                                   Grid.Column="2"/>

                        <TextBlock x:Name="DebugTime"
                                   Text="00:01:44"
                                   Foreground="White"
                                   FontSize="14"
                                   Grid.Column="3"/>
                    </Grid>

                    <Grid Height="4" Margin="0 4 0 0">
                        <Slider x:Name="DebugBar"
                                Style="{StaticResource FlatBarSlider}"
                                Foreground="Gold"
                                Height="4"
                                Maximum="600"
                                Value="0"/>
                    </Grid>
                </StackPanel>

                <!-- Idle -->
                <StackPanel Margin="0 10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Idle"
                                   Foreground="White"
                                   FontSize="14"
                                   Grid.Column="0"/>

                        <TextBlock x:Name="IdleFlipsLabel"
                                   Text="x0"
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="8 0 0 0"
                                   Grid.Column="1"/>

                        <TextBlock Text=""
                                   Grid.Column="2"/>

                        <TextBlock x:Name="IdleTime"
                                   Text="04:55:12"
                                   Foreground="White"
                                   FontSize="14"
                                   Grid.Column="3"/>
                    </Grid>

                    <Grid Height="4" Margin="0 4 0 0">
                        <Slider x:Name="IdleBar"
                                Style="{StaticResource FlatBarSlider}"
                                Foreground="#666"
                                Height="4"
                                Maximum="600"
                                Value="0"/>
                    </Grid>
                </StackPanel>

            </StackPanel>

        </Grid>
    </Border>
</Window>
